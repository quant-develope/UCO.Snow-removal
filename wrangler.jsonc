{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uco-snow-removal",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  // Keep variables set in the Cloudflare dashboard when deploying from git
  "keep_vars": true,
  // Needed by Workers Builds for PR preview builds (`wrangler preview`); service bindings are not copied to previews
  "previews": {},
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // The worker sees every request so it can redirect www and workers.dev to the custom domain
    "run_worker_first": true
  },
  // Leads are duplicated into Toronto CRM (worker crm-toronto1) through its SiteLeads entrypoint
  "services": [{ "binding": "CRM", "service": "crm-toronto1", "entrypoint": "SiteLeads" }]
}
